# Copy this file to the application's data directory as .env.
# The app reads only the selected provider's key at runtime; do not commit real keys.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_BASE_URL=https://api.openai.com/v1
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_BASE_URL=https://api.anthropic.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
OLLAMA_MODEL=gemma4
OLLAMA_BASE_URL=http://127.0.0.1:11434
# Optional authentication for an Ollama-compatible private gateway.
OLLAMA_API_KEY=
LMSTUDIO_API_KEY=
LMSTUDIO_MODEL=openai/gpt-oss-20b
LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1

# Private Qwen deployment; select AI_PROVIDER=qwen to enable.
# The model ID must match vLLM's --served-model-name exactly.
# Non-loopback servers require HTTPS with a trusted certificate and an API token.
QWEN_API_KEY=
QWEN_MODEL=qwen3-coder-30b-a3b
QWEN_BASE_URL=http://127.0.0.1:8000/v1
QWEN_CONTEXT_TOKENS=32768
QWEN_MAX_OUTPUT_TOKENS=2048
QWEN_TIMEOUT_SECONDS=120
QWEN_TEMPERATURE=0.7
QWEN_TOP_P=0.8
QWEN_TOP_K=20
QWEN_REPETITION_PENALTY=1.05
QWEN_SCHEMA_TABLE_LIMIT=32
QWEN_RESULT_ROW_LIMIT=25
# Optional reviewed JSONL evidence; see docs/QWEN_DEPLOYMENT.md.
QWEN_KNOWLEDGE_PATH=
# For relational project-source drafts only. Does not relabel live databases.
# Set db2i only when IBM i is the verified target; also supply its real release.
QWEN_SOURCE_DIALECT=
QWEN_IBMI_RELEASE=
# Optional PEM root CA for a server certificate issued by the client's private CA.
QWEN_CA_CERT_PATH=
