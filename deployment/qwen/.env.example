# Deployment inputs. Blank required values deliberately prevent startup.
# Keep the copied .env private (mode 0600), and never commit it or print docker compose config.
QWEN_SERVER_API_KEY=
QWEN_MODEL_CACHE=
QWEN_TLS_DIRECTORY=
# Use a real private VM interface address to allow client/VPN connections.
QWEN_HOST_BIND=127.0.0.1
QWEN_CONTEXT_TOKENS=32768
QWEN_MAX_OUTPUT_TOKENS=2048
QWEN_MAX_CONCURRENT=2
QWEN_TIMEOUT_SECONDS=120
